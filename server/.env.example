# =========================
# ENV
# =========================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# =========================
# DATABASE
# =========================
MONGODB_URI=mongodb://localhost:27017/dsign-print

# =========================
# AUTH (JWT)
# =========================
JWT_SECRET=change_this_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =========================
# COOKIE (si tu utilises refresh tokens en cookies)
# =========================
COOKIE_SECRET=change_cookie_secret
COOKIE_SECURE=false

# =========================
# CLOUDINARY (images, portfolio, services, etc.)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dsign-print

# =========================
# EMAIL (Nodemailer)
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dsignprint.dev@gmail.com
SMTP_FROM_NAME="D-sign Print"

# =========================
# SECURITY
# =========================
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =========================
# FILE UPLOAD
# =========================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# =========================
# LOGGING
# =========================
LOG_LEVEL=dev

# =========================
# OPTIONAL (future features)
# =========================
ENABLE_SWAGGER=true
ENABLE_EMAILS=true