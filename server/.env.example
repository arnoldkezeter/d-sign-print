# Copier ce fichier en .env et remplir les valeurs reelles.
# Ne jamais committer le .env (deja dans .gitignore normalement).

# Environnement
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
# IMPORTANT: quand le serveur tourne dans Docker, l'hote n'est PAS "localhost"
# mais le nom du service docker-compose ("mongodb"). docker-compose.yml
# force deja cette valeur via "environment:", donc en local hors Docker
# utiliser plutot: mongodb://localhost:27017/d-sign-print
MONGODB_URI=mongodb://mongodb:27017/d-sign-print

# Auth (JWT)
JWT_SECRET=change_moi_au_moins_10_caracteres
JWT_REFRESH_SECRET=change_moi_aussi_au_moins_10_caracteres
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_SECRET=change_moi_au_moins_10_caracteres
COOKIE_SECURE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dsign-print

# Email (Nodemailer / SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dsignprint.com
SMTP_FROM_NAME=D-sign Print

# Securite
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Upload de fichiers
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Logs
LOG_LEVEL=dev

# Feature flags
ENABLE_SWAGGER=false
ENABLE_EMAILS=true

# Seed du premier administrateur (npm run seed:admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@dsignprint.com
ADMIN_PASSWORD=ChangeMe123!
